# Root .env - build-time interpolation for docker-compose.prod.yml only.
#
# Copy to .env beside this file and fill in the deployment's real values:
#
#   cp .env.example .env
#
# Compose loads ./.env automatically for every command it runs against a
# compose file in this directory, which is the whole reason this file exists
# rather than `set -a; source frontend/.env; set +a` in a shell. The three
# variables below are marked required in docker-compose.prod.yml (${VAR:?...}),
# and Compose resolves them when it *parses* the file - so without them not
# just `build` but `up`, `ps`, `logs` and `down` all refuse, including the
# systemd unit's `up -d` after a reboot, when no one is around to have sourced
# anything. A file on disk is always there; an exported shell variable is not.
#
# Only docker-compose.prod.yml interpolates anything. docker-compose.yml (local
# dev) has no ${...} in it, so this file changes nothing about local dev.
#
# NOT a secret store. These three are compiled into the public JS bundle by
# Vite and are readable by anyone who loads the site - that is what they are
# for. Real secrets stay in backend/.env and meeting-bot/.env, which are
# injected as `env_file:` at runtime and never reach a build arg. The root .env
# is gitignored all the same.
#
# Must match frontend/.env, which is what `npm run dev` reads outside Docker.
# Two files, because a Vite dev server and a Compose build read their
# configuration from different places; keep them in step when either changes.

# The backend's public base URL, as the browser will call it - end users hit
# this directly, not through nginx. On EC2 that is the Elastic IP or domain
# with the published backend port, e.g. http://203.0.113.10:8000
VITE_API_URL=http://localhost:8000

# Supabase project URL and anon/publishable key - the same project backend/.env
# points at. The anon key is the client-side one, not the service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
