# Version control
.git
.gitignore

# Node
node_modules/
npm-debug.log*

# Secrets
.env
.env.*
!.env.example

# Debug screenshots left over from local testing - not needed at
# runtime, and some of these may show real meeting content
*.png
*.jpg
zoom-step*.png
zoom-no-input.png

zoom-no-input.png
zoom-step1.png
zoom-step2.png
zoom-step2-direct.png
zoom-step2-no-link.png
zoom-step3.png
zoom-step4.png
zoom-admission-timeout.png


google-meet-prejoin.png
google-meet-after-join-click.png
google-meet-admission-timeout.png
google-meet-alone.png

# Browser profile data generated at runtime - regenerated fresh
# inside the container anyway, don't ship stale local state
browser-profiles/

# Editor/OS noise
.vscode/
.idea/
.DS_Store

# Auth session files - supplied at runtime via the docker-compose bind
# mount (./meeting-bot/auth.json and zoom-auth.json), never baked into
# the image. NOTE: this used to read "meeting-bot/auth.json", which is
# wrong for a .dockerignore that already lives inside the meeting-bot/
# build context (paths here are relative to that context root, not the
# repo root) - it never matched anything, so every build was silently
# copying the real Google (and now Zoom) session cookies into the image
# layer. Fixed to the correct context-relative paths below.
auth.json
zoom-auth.json

# Manual local-only auth-generation tools - launch a headed Chrome
# profile at a hardcoded Windows path (C:\chrome-bot-profile[-zoom]) and
# wait on interactive terminal input. Never run inside the deployed
# Linux container, no reason to ship them in the image.
generate-auth.cjs
generate-zoom-auth.cjs

# Per-host credential directories (auth/bot-a, auth/bot-b, ...). The
# auth.json / zoom-auth.json rules above are context-root-relative and do
# NOT match auth/bot-a/auth.json, so without this the live Google and Zoom
# session cookies are copied into an image layer - the same leak those
# rules were written to close.
auth/

# Recordings kept on the host after a failed upload. Not needed to build the
# image, and a real recording left in a local checkout would otherwise be
# baked into a layer.
recordings/
recordings-2/
