PORT=3000

# Optional, off by default. Set to "true" to dump per-step screenshots of
# the join flow to disk for local troubleshooting - these capture real
# meeting content, so never enable in production.
DEBUG_SCREENSHOTS=false

# Same value as backend's MEETING_BOT_BEARER_TOKEN - one shared secret
BEARER_TOKEN=generate-a-long-random-string

# Backend webhook to notify when a recording finishes
BACKEND_WEBHOOK_URL=http://backend:8000/webhooks/recording-complete
MAX_RECORDING_DURATION_MINUTES=90

# How many meetings this instance will record at once. Safe to raise above 1
# with per-session PulseAudio sink isolation (see AudioSink.js).
MAX_CONCURRENT_MEETINGS=1

# Keeps auth.json and zoom-auth.json's session cookies from expiring
# between real meeting joins (see AuthKeepAlive.js and
# docs/auth-keepalive-runbook.md). Runs a real headed Chrome on a timer for
# each platform -- set to false to disable, e.g. if running node directly
# on a Windows dev machine and the periodic Chrome windows are disruptive.
AUTH_KEEPALIVE_ENABLED=true
AUTH_KEEPALIVE_INTERVAL_MINUTES=15

# Optional. Where the signed-in browser sessions live. Unset means
# meeting-bot/auth.json and meeting-bot/zoom-auth.json (the docker-compose
# bind-mount paths). Set these when the files are mounted elsewhere, e.g.
# Render Secret Files: AUTH_STATE_PATH=/etc/secrets/auth.json
# Generate them with generate-auth.cjs / generate-zoom-auth.cjs.
# AUTH_STATE_PATH=
# ZOOM_AUTH_STATE_PATH=

# Supabase direct connection (used by SupabaseUploader) - same project as backend
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_RECORDINGS_BUCKET=recordings
