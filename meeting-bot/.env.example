PORT=3000

# Same value as backend's MEETING_BOT_BEARER_TOKEN - one shared secret
BEARER_TOKEN=generate-a-long-random-string

# Backend webhook to notify when a recording finishes
BACKEND_WEBHOOK_URL=http://backend:8000/webhooks/recording-complete
MAX_RECORDING_DURATION_MINUTES=90

# Supabase direct connection (used by SupabaseUploader) - same project as backend
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_RECORDINGS_BUCKET=recordings
