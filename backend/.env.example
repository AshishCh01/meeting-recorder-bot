# Supabase (database + storage)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_RECORDINGS_BUCKET=recordings

# Postgres connection for SQLAlchemy & Alembic - use the Supabase
# connection pooler URL (Project Settings > Database > Connection pooling)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# meeting-bot service - same value as meeting-bot's BEARER_TOKEN
MEETING_BOT_URL=http://meeting-bot:3000
MEETING_BOT_BEARER_TOKEN=generate-a-long-random-string

# CORS - the frontend's origin
FRONTEND_ORIGIN=http://localhost:5173

GEMINI_API_KEY=your-gemini-api-key

# Cost tracking - per-million-token USD rates used for the [cost] log
# lines in transcription_service.py, chat_service.py, and
# embedding_service.py. Update these when Gemini's pricing changes.
GEMINI_INPUT_COST_PER_MTOK=0.30
GEMINI_OUTPUT_COST_PER_MTOK=2.50
GEMINI_EMBEDDING_COST_PER_MTOK=0.15

# Optional fallback providers - leave blank to disable
# SARVAM_API_KEY: transcription fallback when Gemini is down
# JINA_API_KEY:   embedding fallback when Gemini is down
# GROQ_API_KEY:   "Ask about this meeting" chat fallback when Gemini is down.
#                 GROQ_CHAT_MODEL must support tool calling.
SARVAM_API_KEY=
JINA_API_KEY=
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Google Calendar integration - optional, leave blank to disable.
# GOOGLE_CLIENT_ID/SECRET: Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/calendar/oauth/callback
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Transcription queue (docs/scaling-plan.md Phase A3).
# REDIS_URL points at the `redis` service in both compose files. The worker
# container runs `arq app.worker.WorkerSettings` against the same URL.
REDIS_URL=redis://redis:6379
# The cutover flag, and the rollback. false keeps transcription on the
# in-process ThreadPoolExecutor (deploy 1: Redis and the worker running,
# nothing behaviourally different). Flip to true for deploy 2.
TRANSCRIPTION_USE_QUEUE=false

# Observability (docs/scaling-plan.md Phase A4). Optional - leave SENTRY_DSN
# blank and Sentry is never initialised, in the API or the worker. Create a
# project in Sentry and paste its DSN here to turn it on. ENVIRONMENT already
# separates local noise from the deployed stack in the Sentry UI.
SENTRY_DSN=
# Errors only. Raise above 0.0 to also sample performance traces (billable).
SENTRY_TRACES_SAMPLE_RATE=0.0
# Root log level for both entrypoints. Without app/observability.py configuring
# root from this, every logger.* call in app/ is silently dropped.
LOG_LEVEL=INFO

# Local JWT verification (docs/scaling-plan.md Phase A5). This project signs
# access tokens with ES256; the public keys are fetched from
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json and nothing secret is stored.
#
# The kill switch, and the fastest revert: false restores the pre-A5
# supabase.auth.get_user() call on every request, no rebuild needed.
JWT_LOCAL_VERIFICATION_ENABLED=true
# The safety net under it - on any local verification failure, ask Supabase
# before rejecting. Every fire is counted, logged and reported to Sentry.
# Leave this on until the fallback counter has sat at zero under real traffic.
AUTH_FALLBACK_ENABLED=true
# Read off a real token, not assumed. Blank JWT_ISSUER / SUPABASE_JWKS_URL are
# derived from SUPABASE_URL; override only if your project differs.
JWT_AUDIENCE=authenticated
JWT_ISSUER=
SUPABASE_JWKS_URL=
