# syntax=docker/dockerfile:1
# Start with a lightweight Python environment
FROM python:3.12-slim

# Set the working directory inside the container
WORKDIR /app

# Install ffmpeg for transcription_service.py (required for _is_audio_silent)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Copy the pinned dependency files first. requirements-dev.txt pulls in
# requirements.txt via `-r`, so both must be present before the install.
COPY requirements.txt requirements-dev.txt ./

# Dev image: runtime deps plus the test runner. The production image
# (backend/Dockerfile) installs requirements.txt only.
#
# Do NOT run the suite with `docker compose exec backend python -m pytest`.
# Compose injects backend/.env as real environment variables, so the test
# process would hold real Groq/Jina/Sarvam/Google keys - one unstubbed
# fallback away from a billed call. IGNORE_DOTENV only stops the app reading
# the file, not compose exporting it. Run tests from the host venv, or with
# `docker run --rm` on this image - see tests/README.md.

# --timeout/--retries: pip's default 15s read timeout gives up on a slow
# link to files.pythonhosted.org, which fails the whole build several
# hundred MB in. The cache mount keeps downloaded wheels outside the image
# and outside the failed layer, so a retry resumes instead of restarting -
# which is why --no-cache-dir is deliberately NOT used here. It is still
# used in the production Dockerfile, where image size matters more than
# rebuild speed.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 120 --retries 10 -r requirements-dev.txt

# Copy the rest of your backend code
COPY . .


ENV PYTHONUNBUFFERED=1
# Expose the FastAPI port
EXPOSE 8000

# Run pending migrations, then start FastAPI with the reload flag
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"]