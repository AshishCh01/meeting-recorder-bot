# Start with a lightweight Node environment
FROM node:22-alpine

# Set the working directory inside the container
WORKDIR /app

# Copy dependency definitions and install them
COPY package*.json ./
RUN npm install

# Copy the rest of the frontend code
COPY . .

# Expose standard Vite/React ports
EXPOSE 3000
EXPOSE 5173

# Start the frontend application with live-reload
CMD ["npm", "run", "dev"]